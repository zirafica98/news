{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/ai-jutro/browser",
  "crons": [
    {
      "path": "/api/pokreni-izdanje",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/pokreni-izdanje",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/pokreni-izdanje?rezim=drustvene",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/engine",
      "destination": "/engine/index.html"
    },
    {
      "source": "/((?!data/|api/|engine|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!engine).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/engine(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
