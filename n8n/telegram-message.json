{
  "name": "AI Morning Brief · Telegram message",
  "nodes": [
    {
      "parameters": {
        "content": "## AI Morning Brief · Telegram message\nWrite a message in a form and the bot posts it: to you (test), to the AI Morning Brief channel, or to any group or channel where the bot is an admin. Optional image, silent sending and pinning.",
        "width": 520,
        "height": 200,
        "color": 4
      },
      "id": "31474429-6dac-4d04-bc61-cc637118f91d",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -300
      ]
    },
    {
      "parameters": {
        "formTitle": "Send a Telegram message",
        "formDescription": "The AI Morning Brief bot sends your message. For groups or other channels the bot must be an admin (with the right to post, and to pin if you pin).",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Send to",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Me (private test)"
                  },
                  {
                    "option": "AI Morning Brief channel"
                  },
                  {
                    "option": "Other group or channel"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Chat ID or @username (only for other group or channel)",
              "placeholder": "-1001234567890 or @mychannel"
            },
            {
              "fieldLabel": "Message",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Image URL (optional)",
              "placeholder": "https://…/image.jpg"
            },
            {
              "fieldLabel": "Options",
              "fieldType": "checkbox",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Send silently"
                  },
                  {
                    "option": "Pin the message"
                  }
                ]
              }
            }
          ]
        },
        "options": {}
      },
      "id": "cf570997-2e01-4cc6-a1ee-1aa6c5d56036",
      "name": "Write the message",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "webhookId": "e02acda7-3a30-4515-9bb1-f0f2e90474cd"
    },
    {
      "parameters": {
        "jsCode": "// Resolve where the message goes and check Telegram's length limits before sending.\nconst CHANNEL = '@aimorningbrief';   // public channel AI Morning Brief\nconst ME = '6396725385';             // private chat with the bot (test target)\nconst f = $input.first().json;\nconst target = f['Send to'];\nconst other = String(f['Chat ID or @username (only for other group or channel)'] ?? '').trim();\nconst chatId = target === 'Me (private test)' ? ME : target === 'AI Morning Brief channel' ? CHANNEL : other;\nif (!chatId) throw new Error('Enter a chat ID or @username for the other group or channel.');\nconst text = String(f.Message ?? '').trim();\nconst image = String(f['Image URL (optional)'] ?? '').trim();\nif (image && !/^https?:\\/\\//.test(image)) throw new Error('The image must be a full https:// link.');\nif (image && text.length > 1024) throw new Error(`With an image Telegram allows 1024 characters; this message has ${text.length}.`);\nif (text.length > 4096) throw new Error(`Telegram allows 4096 characters; this message has ${text.length}.`);\nconst options = [].concat(f.Options ?? []);\nreturn [{ json: { chatId, text, image, silent: options.includes('Send silently'), pin: options.includes('Pin the message'), target } }];"
      },
      "id": "6e375087-49e2-47b9-b9cc-c17d7e359d17",
      "name": "Prepare message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
